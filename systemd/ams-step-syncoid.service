[Unit]
Description=AMS chain step: off-box ZFS replication of the dataset (runs ~/.mem0/scripts/syncoid.sh; skipped when that script is absent)
PartOf=ams-nightly.target
After=mem0.service ams-step-stack-backup.service
ConditionPathExists=%h/.mem0/scripts/syncoid.sh

[Service]
Type=oneshot
# Files this unit creates are readable by their owner only (state holds full memory text).
UMask=0077
ExecStart=/bin/bash %h/apps/mem0-scripts/ams-step.sh syncoid /bin/bash %h/.mem0/scripts/syncoid.sh

[Install]
WantedBy=ams-nightly.target
