[Unit]
Description=v0.27.4 R5: weekly episodic-ledger reconciliation (drift detection — orphaned mem0 links / dangling episodes; abandons stale checkpoints, backfills episode embeddings)
After=network-online.target

[Service]
Type=oneshot
# Drift detection is READ-ONLY by construction (the SQLite ledger is opened mode=ro; orphaned links
# are reported, never deleted). WP-4: the run also sets in_progress episodes untouched for 7 days to
# abandoned (its one write, counted in the receipt) and embeds up to 500 missing episode summaries
# (needs the embedder; skipped when it is down). Reports to ~/.mem0/episodic-reconciliation.jsonl
# (read by Test-MemoryStack). No Codex / no shim needed.
ExecStart=/home/__WSL_USER__/apps/mem0-server/.venv/bin/python %h/apps/mem0-scripts/episodic-reconcile.py
StandardOutput=journal
StandardError=journal
