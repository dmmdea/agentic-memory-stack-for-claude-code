[Unit]
Description=AMS chain step: morning summary section from the night's receipts
PartOf=ams-nightly.target
After=mem0.service ams-step-health-stamp.service

[Service]
Type=oneshot
# Files this unit creates are readable by their owner only (state holds full memory text).
UMask=0077
ExecStart=/bin/bash %h/apps/mem0-scripts/ams-step.sh morning-summary /bin/bash %h/apps/mem0-scripts/ams-morning-summary.sh

[Install]
WantedBy=ams-nightly.target
