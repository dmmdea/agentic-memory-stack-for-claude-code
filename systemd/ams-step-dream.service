[Unit]
Description=AMS chain step: dream consolidator (Python port; native Codex judge; quota gate)
PartOf=ams-nightly.target
After=mem0.service

[Service]
Type=oneshot
LoadCredentialEncrypted=ams-api-key:__SECRETS_DIR__/ams-api-key.cred
Environment=MEM0_API_KEY_FILE=%d/ams-api-key
Environment=MEM0_HOST_KIND=native
Environment=MEM0_CODEX_TRANSPORT=native
LoadCredentialEncrypted=ams-canonical-key:__SECRETS_DIR__/ams-canonical-key.cred
Environment=CODEX_HOME=__SECRETS_DIR__/codex
ExecStartPre=-%h/apps/mem0-server/.venv/bin/python %h/apps/mem0-scripts/codex-usage-report.py --probe
ExecStart=/bin/bash %h/apps/mem0-scripts/ams-step.sh --guarded dream %h/apps/mem0-server/.venv/bin/python %h/apps/mem0-scripts/dream-consolidate.py

[Install]
WantedBy=ams-nightly.target
