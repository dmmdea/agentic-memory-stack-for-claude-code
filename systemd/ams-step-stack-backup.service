[Unit]
Description=AMS chain step: stack backup (snapshot set for the replicas' refresh path)
PartOf=ams-nightly.target
After=mem0.service

[Service]
Type=oneshot
ExecStart=/bin/bash %h/apps/mem0-scripts/ams-step.sh --guard stack-backup /bin/bash %h/apps/mem0-scripts/stack-backup.sh

[Install]
WantedBy=ams-nightly.target
