[Unit]
Description=AMS chain step: stack backup (snapshot set for the replicas' refresh path; stamps last-chain-success)
PartOf=ams-nightly.target
After=mem0.service ams-step-retrieval-pairs.service

[Service]
Type=oneshot
# Files this unit creates are readable by their owner only (state holds full memory text).
UMask=0077
ExecStart=/bin/bash %h/apps/mem0-scripts/ams-step.sh --guard stack-backup /bin/bash %h/apps/mem0-scripts/stack-backup.sh

[Install]
WantedBy=ams-nightly.target
