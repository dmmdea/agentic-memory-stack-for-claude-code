[Unit]
Description=AMS chain step: arm the RTC wake for the next 02:45
PartOf=ams-nightly.target
After=mem0.service ams-step-health-stamp.service

[Service]
Type=oneshot
ExecStart=/bin/bash %h/apps/mem0-scripts/ams-step.sh rtcwake /bin/bash %h/apps/mem0-scripts/ams-rtcwake-arm.sh 02:45

[Install]
WantedBy=ams-nightly.target
