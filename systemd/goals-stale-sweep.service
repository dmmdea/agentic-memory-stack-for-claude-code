[Unit]
Description=Weekly stale-goal sweeper (flags stale goals, auto-abandons the ones past the script's inactivity window)
After=network-online.target

[Service]
Type=oneshot
# --auto-abandon is standing, SCOPED by the script itself — never manual goals, and only past 90 days of
# inactivity (--abandon-days default). Reporting still flags at --stale-days.
ExecStart=/home/__WSL_USER__/apps/mem0-server/.venv/bin/python %h/apps/mem0-scripts/goals-stale-sweep.py --auto-abandon
StandardOutput=journal
StandardError=journal
