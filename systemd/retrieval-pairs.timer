[Unit]
Description=Weekly judged retrieval-pairs timer (Sun 07:00 - AFTER the discovery sweep's worst case; Codex-judged, capped)
# 2026-08-24 review HIGH: 05:15 sat inside the discovery sweep's own 05:00 +
# <=15m + "worst-case ~1-2h" window, and the codex shim is a SINGLE-THREADED
# accept loop - this unit's requests queued behind 20-45s codex calls and
# surfaced as client timeouts (the lost-week class wearing a different label).
# 07:00 clears the common case; the client-side busy-retry budget covers the
# residual overlap and boot catch-up compression.

[Timer]
OnCalendar=Sun 07:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
