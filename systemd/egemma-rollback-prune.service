[Unit]
Description=Embedding-space rollback-window cleanup (operator-armed, profile- and health-gated)
# Deletes the PREVIOUS embedding space's Qdrant collections + their snapshots (the rollback anchor a
# migration leaves beside the new space, scripts/wsl/embedder-migrate.py) ONLY when the migration is
# confirmed durable: mem0 /health/deep reports embed_profile.profile == the NEW profile AND is STILL
# BOUND to the new memories collection (the binding-based rollback guard, v0.22 H2), the embedder
# probe is ok, and the new collection is green with enough points. Each old collection also needs
# its own counterpart in the new space to be green and non-empty. After a rollback it SKIPs and logs
# a ROLLBACK DETECTED flag. Which profiles: EGEMMA_PRUNE_NEW_PROFILE / EGEMMA_PRUNE_OLD_PROFILE (a
# drop-in Environment=; defaults egemma2 / egemma-300m). Disable the timer as STEP 1 of any rollback
# (see ARCHITECTURE.md). No installer enables the timer.

[Service]
Type=oneshot
ExecStart=/bin/bash %h/.mem0/egemma-rollback-prune.sh
