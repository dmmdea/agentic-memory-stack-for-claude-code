[Unit]
Description=AMS chain step: MEMORY.md index refresh (decoupled from the dream; no-op after a full dream)
PartOf=ams-nightly.target
After=mem0.service ams-step-semantic-dedup.service

[Service]
Type=oneshot
LoadCredentialEncrypted=ams-api-key:__SECRETS_DIR__/ams-api-key.cred
Environment=MEM0_API_KEY_FILE=%d/ams-api-key
Environment=MEM0_HOST_KIND=native
Environment=MEM0_CODEX_TRANSPORT=native
ExecStart=/bin/bash %h/apps/mem0-scripts/ams-step.sh --guarded index-refresh %h/apps/mem0-server/.venv/bin/python %h/apps/mem0-scripts/memory-index-refresh.py

[Install]
WantedBy=ams-nightly.target
