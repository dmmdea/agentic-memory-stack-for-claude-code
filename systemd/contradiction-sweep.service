[Unit]
Description=v0.19 I.3: weekly offline contradiction sweep (canonical vs similar candidates; cheap local discovery)
After=network-online.target

[Service]
Type=oneshot
# C5 (2026-07-03, audit decision 2026-06-14): contradiction judging is JUDGMENT
# work -> Codex via the Windows shim (:18792); local models are never the judge
# (an earlier 3B local judge YES'd 9/9 pairs spuriously, and the v0.27.3
# re-judge measured 78% false positives on local verdicts). This REVERSES the
# v0.27.3 `--judge local` trade: the script preflights the shim and NO-OPs
# (exit 0, outcome=no-op:codex-shim-unreachable) when it is down — at the
# unattended Sun 05:00 slot that usually means the week is SKIPPED, and that is
# the intended trade: a skipped week (false NO) is strictly better than a weak
# local YES polluting the store with spurious advisory stamps. It NEVER falls
# back to local (that would re-introduce the audited misrouting). The
# session-time SessionStart rejudge (storage-cap-check.sh, fires when the shim
# IS up, weekly-throttled) resolves EXISTING stamps — but it runs
# --rejudge-stamped, so it never DISCOVERS new contradictions. This unit is the
# only discovery pass in the stack; a skipped week here is a week with no
# discovery at all.
#
# AMS-07 (W4): 7/7 historical runs were no-ops because the Codex shim was never
# up at 05:00 — its spawn was gated on a flag nothing creates, and even after
# that decoupling a session-spawned shim self-shuts after 240 idle minutes, so
# Sunday 05:00 would still find it down. ExecStartPre spawns the shim ON DEMAND
# (fail-soft '-': if the spawn cannot run, the sweep still preflights and
# no-ops exactly as before — never a hard failure, never a local-judge
# fallback). Spawning a Windows process from WSL is sound here because the shim
# is reached over HTTP, not stdio: only its stdout would be mangled, and
# nothing reads it.
ExecStartPre=-/usr/bin/env powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\\Users\\__WIN_USER__\\.claude\\scripts\\codex-shim-spawn.ps1
ExecStart=/home/__WSL_USER__/apps/mem0-server/.venv/bin/python %h/apps/mem0-scripts/contradiction-sweep.py --apply --limit 50 --judge codex
StandardOutput=journal
StandardError=journal
