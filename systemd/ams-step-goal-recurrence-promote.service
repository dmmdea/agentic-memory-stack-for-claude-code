[Unit]
Description=AMS chain step: goal recurrence promotion (daily)
PartOf=ams-nightly.target
After=mem0.service ams-step-index-refresh.service

[Service]
Type=oneshot
LoadCredentialEncrypted=ams-api-key:__SECRETS_DIR__/ams-api-key.cred
Environment=MEM0_API_KEY_FILE=%d/ams-api-key
Environment=MEM0_HOST_KIND=native
Environment=MEM0_CODEX_TRANSPORT=native
ExecStart=/bin/bash %h/apps/mem0-scripts/ams-step.sh --guarded goal-recurrence-promote %h/apps/mem0-server/.venv/bin/python %h/apps/mem0-scripts/jobs.py run goal-recurrence-promote --receipt %h/.mem0/goal-recurrence-promote.jsonl --stale-after 1800 -- %h/apps/mem0-server/.venv/bin/python %h/apps/mem0-scripts/goal-recurrence-promote.py --apply

[Install]
WantedBy=ams-nightly.target
